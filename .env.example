# Copy to .env.local and fill in what you need. Everything is optional:
# without an API key the app uses its built-in rule-based stylist and offline parsers.

# --- Claude (Anthropic API) -------------------------------------------------
# Server-side only; never sent to the browser.
ANTHROPIC_API_KEY=
# Model used for the stylist, imports and planning.
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max (leave empty to omit for models that don't support it).
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback ("default" = Anthropic's recommended fallback model). Set to "off"
# if you choose a model that doesn't support the `fallbacks` parameter.
ANTHROPIC_REFUSAL_FALLBACK=default
# Set to 1 to switch Claude off entirely (useful for tests / offline use).
AI_DISABLED=

# --- Storage ------------------------------------------------------------------
# SQLite database file (created automatically, migrations run on start).
DATABASE_PATH=./data/wardrobe.db
# Where uploaded garment photos are stored.
UPLOADS_DIR=./data/uploads

# --- Network ------------------------------------------------------------------
# The app only answers requests addressed to localhost. To use it from another device on
# your network, start it with `npm start -- -H 0.0.0.0` and list the host names here.
ALLOWED_HOSTS=

# Optional Open-Meteo endpoint overrides (e.g. a self-hosted instance).
OPEN_METEO_FORECAST_URL=
OPEN_METEO_GEOCODING_URL=
