# Copy to .env.local and fill in what you need. Everything is optional:
# without an AI provider the app uses its built-in rule-based stylist and offline parsers.
# Keys can also be added in Settings → AI providers (stored in SECRETS_PATH, mode 600).

# --- AI providers (server-side only; never sent to the browser) --------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Initial models (until one is chosen in Settings). Defaults are the providers' documented
# recommendations: claude-opus-5-5, gpt-6.1-sol, gemini-3.8-flash.
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
# Claude effort (low | medium | high | xhigh | max); empty = the model's default.
ANTHROPIC_EFFORT=
# Server-side refusal fallback on Claude models that support it; "off" to disable.
ANTHROPIC_REFUSAL_FALLBACK=default
# Where keys entered in Settings are stored (default: next to the database).
SECRETS_PATH=
# Set to 1 to switch AI off entirely.
AI_DISABLED=

# --- Storage ------------------------------------------------------------------
# SQLite database file (created automatically, migrations run on start).
DATABASE_PATH=./data/wardrobe.db
# Where uploaded garment photos are stored.
UPLOADS_DIR=./data/uploads

# --- Network ------------------------------------------------------------------
# The app only answers requests addressed to localhost. To use it from another device on
# your network, start it with `npm start -- -H 0.0.0.0` and list the host names here.
ALLOWED_HOSTS=

# Optional Open-Meteo endpoint overrides (e.g. a self-hosted instance).
OPEN_METEO_FORECAST_URL=
OPEN_METEO_GEOCODING_URL=
