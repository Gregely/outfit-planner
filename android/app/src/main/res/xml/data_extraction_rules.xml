<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device transfer: the wardrobe (database, photos) is included; encrypted
  API keys are not – they're tied to this device's Keystore and can't be decrypted elsewhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
        <exclude domain="file" path="exports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
